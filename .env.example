# ── Ingestion ──────────────────────────────────────────────────────────────
# Path to your Apple Health export.xml (used by: make ingest EXPORT_PATH=...)
# EXPORT_PATH=/path/to/export.xml

# ── LLM ────────────────────────────────────────────────────────────────────
# Provider choice: 'groq' (hosted, default) or 'local' (LiteRT-LM, offline).
# Persisted in the app-state DB; env is the first-run default.
# TTI_PROVIDER=groq

# Get a free Groq key at https://console.groq.com
LLM_API_KEY=your-api-key-here

# OpenAI-compatible base URL (default: Groq)
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Model name (default: llama-3.3-70b-versatile)
# LLM_MODEL=llama-3.3-70b-versatile

# ── Local LLM (LiteRT-LM, gemma4-e2b) — offline, zero egress ───────────────
# LiteRT serves an OpenAI-compatible API on localhost:9379/v1.
# Install: pip install litert-lm && litert-lm import --from-huggingface-repo litert-community/gemma-4-E2B-it-litert-lm gemma-4-E2B-it.litertlm gemma4-e2b
# Serve (managed via Settings → LLM Provider → Start/Stop, or manually):
# litert-lm serve --model gemma4-e2b --host 127.0.0.1 --port 9379
# Override the serve command if the binary is not on PATH (fallback: ~/litert-lm/.venv/bin/litert-lm):
# LITERT_SERVE_CMD=litert-lm serve --model gemma4-e2b
# LITERT_BASE_URL=http://127.0.0.1:9379/v1
# LITERT_MODEL=gemma4-e2b

# ── Database ────────────────────────────────────────────────────────────────
# Path to the local DuckDB file (created by make ingest)
# TTI_DB_PATH=backend/data/health.duckdb
